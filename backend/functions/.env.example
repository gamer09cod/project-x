# db.js / apply+verify scripts read PG_* (process.env wins over functions.config().pg).
# Direct 5432 is required. Do not use the transaction-mode pooler (6543).
# Copy to backend/functions/.env (gitignored). firebase deploy uploads .env to Functions.
PG_HOST=db.PROJECT_REF.supabase.co
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres
PG_PASSWORD=PASSWORD

# Phase 9: comma-separated unityBuildId allowlist. Empty = accept all builds (dev).
# UNITY_BUILD_ALLOWLIST=basketball_v1-phase6

# Stage 1 anti-cheat. Unset = shadow mode: plausibility signals are recorded on
# match_players.score_plausibility but never change the accepted score.
# Do not set to 1 until the thresholds in src/match/verify.js have been
# calibrated against real runs, or honest players will be zeroed.
# SCORE_PLAUSIBILITY_ENFORCE=1
