{
  "name": "mobile",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "start": "react-native start",
    "android": "node ../scripts/patch-azesmway-unity.js && react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "patch:azesmway": "node ../scripts/patch-azesmway-unity.js"
  },
  "dependencies": {
    "@azesmway/react-native-unity": "1.1.1",
    "@project-x/shared": "*",
    "@react-native-firebase/app": "26.3.3",
    "@react-native-firebase/app-check": "26.3.3",
    "@react-native-firebase/auth": "26.3.3",
    "@react-native-firebase/functions": "26.3.3",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@babel/core": "7.25.2",
    "@babel/preset-env": "7.25.3",
    "@babel/runtime": "7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  }
}
